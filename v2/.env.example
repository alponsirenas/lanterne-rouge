# Copy this to .env and fill in your credentials.

# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Oura Ring (required for readiness data)
OURA_TOKEN=...

# Strava (required for CTL/ATL/TSB)
STRAVA_CLIENT_ID=...
STRAVA_CLIENT_SECRET=...
STRAVA_ACCESS_TOKEN=...
STRAVA_REFRESH_TOKEN=...

# Optional: override default mission config path
# MISSION_CONFIG=missions/example.toml
